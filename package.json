{
  "name": "ux-hub-dice",
  "version": "0.2.0",
  "private": true,
  "description": "Floating hand-drawn random name picker that survives fullscreen presentations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --universal",
    "dist:fast": "electron-builder --mac --arm64 --dir"
  },
  "build": {
    "appId": "com.johnnydong.uxhubdice",
    "productName": "Name Picker",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "shapes.js",
      "app.js",
      "index.html",
      "styles.css",
      "roster.js",
      "roster-preload.js",
      "roster-renderer.js",
      "roster.html",
      "roster.css",
      "animation-frames/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": 1
      },
      "icon": "assets/icon.png",
      "identity": null
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
